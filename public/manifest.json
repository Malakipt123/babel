{
  "manifest_version": 3,
  "name": "Babelbee: Reply to Buyers in Any Language",
  "short_name": "Babelbee",
  "version": "0.1.0",
  "description": "Translate buyer messages and reply in their language in seconds. For marketplace sellers. No API key.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Babelbee",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "contextMenus", "sidePanel", "activeTab"]
}
